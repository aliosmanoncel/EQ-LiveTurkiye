{
 "metadata": {
  "title": "Large (Ms >= 6.8) earthquakes in the Marmara Sea region over the last 20 centuries",
  "source": "Ambraseys, N. (2002), The Seismic Activity of the Marmara Sea Region over the Last 2000 Years, Bulletin of the Seismological Society of America, 92(1), 1-18",
  "doi": "10.1785/0120000843",
  "table_reference": "Table 1, p.8",
  "region_scope": "Marmara Sea region only (NOT a general Turkey/Europe catalog) -- distinct dataset from data/epica_europe_historical.json (EPICA v1.1 + SHARE-CET), which uses a different, broader-region homogenization methodology (Soysal-based Io->Ms->Mw chain). Kept as a SEPARATE layer per user decision (2026-09-12) rather than merged, to avoid conflating two independently-derived magnitude scales for the same region.",
  "total_events_in_table": 55,
  "discrepancy_note": "The paper's own body text (p.10) states 'Table 1 lists 54 events from the dataset of Ms>=6.8', but the printed table itself contains 55 numbered rows (01-55). Presumed a minor off-by-one inconsistency in the original publication; all 55 numbered rows transcribed as printed, none omitted.",
  "magnitude_scale": "Ms (surface-wave magnitude) -- preserved AS Ms, never relabeled or silently converted to Mw. See each event's magnitude.type field.",
  "moment_units": "M0 in units of 10^26 dyne-cm, from Ekstrom & Dziewonski (1988) global Ms-M0 relation",
  "magnitude_class_thresholds": "moderate: 6.8<=Ms<7.0; large: 7.0<=Ms<7.4; major: Ms>=7.4 (as defined in source Table 1 footnote)",
  "field_legend": {
   "1_location": {
    "1": "on land",
    "2": "offshore",
    "3": "at sea"
   },
   "2_epicentral_quality": {
    "1": "instrumental",
    "2": "well-defined macroseismic",
    "3": "less well defined",
    "4": "adopted"
   },
   "3_num_sites": "number of sites used to estimate magnitude",
   "4_magnitude_type": {
    "1": "instrumental",
    "2": "macroseismic"
   },
   "5_max_effects": {
    "1": "considerable damage",
    "2": "heavy damage",
    "3": "destructive / extensive reconstruction, social-economic repercussions"
   },
   "6_loss_of_life": {
    "0": "none reported",
    "1": "small",
    "2": "significant",
    "3": "great"
   },
   "7_damage_extent": {
    "0": "not reported",
    "1": "local",
    "2": "widespread"
   },
   "8_felt_area": {
    "0": "not reported",
    "1": "small",
    "2": "large"
   },
   "9_ground_effects": {
    "0": "none reported",
    "1": "surface faulting",
    "2": "ground failures and landslides"
   },
   "10_seismic_sea_waves": {
    "0": "none reported",
    "1": "damaging",
    "2": "observed"
   }
  },
  "extraction_method": "Table 1 was extracted by direct PDF text extraction (PyMuPDF) from the user's own Zotero library copy of the article, then manually transcribed row-by-row into structured fields and cross-checked against the raw extracted text. No OCR was used (the PDF has a genuine text layer). No values were estimated, interpolated, or corrected beyond what is printed in the table.",
  "crosswalk_status": {
   "epica_share_cet": "NOT APPLICABLE for any of the 55 events checked so far in this pass: data/epica_europe_historical.json is capped at year<=1899 by its own build script (scripts/_merge_share_cet.py, YEAR_MAX=1899), while the 9 events the user flagged for crosswalk review are all 1912-1999, i.e. structurally outside that catalog's covered period. No pre-1900 Ambraseys-vs-EPICA/SHARE-CET crosswalk (events no. 1-46) has been attempted in this pass -- that would be a separate, larger follow-up task if wanted.",
   "eq_historical_json": "Crosswalk completed for the 9 user-flagged events (nos. 47-55) against data/eq_historical.json (ISC 1900-1997 + EMSC 1998-2026). See data/marmara_ambraseys_eq_historical_crosswalk.json for the full per-event comparison, confidence, and rationale. NOT merged/deduped -- both records are preserved independently and linked only via canonical_event_id."
  },
  "known_limitations": [
   "Locations for pre-1900 events (especially those 'at sea') are approximate macroseismic-region centroids, not instrumental epicenters -- the source paper itself states this explicitly (p.9-10).",
   "Two additional rows marked with the source table's own uncertainty marker (event no. '00', all-zero fields) are recorded separately in this file under 'excluded_uncertain_entries' -- 'Panium' (823) and 'Saros?' (1489) -- and were NOT included in the 55-event 'events' array because no magnitude was assessed for them in the source.",
   "OT (origin time) field is reproduced as printed; a value of '0000' most likely means 'not reported' for most early events rather than an actual midnight origin time, per the source paper's general discussion of data quality for early events.",
   "Coordinates are given in the source only to 0.1 degree precision (approximately 10 km) -- do not treat as precise instrumental epicenters."
  ],
  "digitized_by": "Claude (direct PDF text extraction from user's Zotero copy), transcribed 2026-09-12; magnitude schema and crosswalk added 2026-09-12",
  "event_count": 55
